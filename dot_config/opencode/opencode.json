{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-terra",
  "lsp": true,
  "formatter": true,
  "tools": {
    "agentgateway_*": false,
    "github_*": false,
    "memadd": false,
    "memcommit": false,
    "memqueue": false,
    "memremove": false,
    "agentgateway_grafana-mcp-http_list_datasources": true,
    "agentgateway_grafana-mcp-http_search_dashboards": true,
    "agentgateway_grafana-mcp-http_get_dashboard_summary": true,
    "agentgateway_grafana-mcp-http_get_dashboard_property": true,
    "agentgateway_grafana-mcp-http_get_dashboard_panel_queries": true,
    "agentgateway_grafana-mcp-http_generate_deeplink": true,
    "agentgateway_grafana-mcp-http_grafana_api_request": true,
    "agentgateway_grafana-mcp-http_get_annotations": true,
    "agentgateway_kubernetes-mcp-server-http_*": true,
    "agentgateway_plane_create_work_item": true,
    "agentgateway_plane_create_work_item_comment": true,
    "agentgateway_plane_delete_work_item_comment": true,
    "agentgateway_plane_get_project_members": true,
    "agentgateway_plane_list_labels": true,
    "agentgateway_plane_list_states": true,
    "agentgateway_plane_list_work_items": true,
    "agentgateway_plane_list_work_item_activities": true,
    "agentgateway_plane_list_work_item_comments": true,
    "agentgateway_plane_manage_work_item_assignee": true,
    "agentgateway_plane_manage_work_item_label": true,
    "agentgateway_plane_retrieve_work_item": true,
    "agentgateway_plane_retrieve_work_item_by_identifier": true,
    "agentgateway_plane_search_work_items": true,
    "agentgateway_plane_update_work_item": true,
    "agentgateway_plane_update_work_item_comment": true,
    "github_get_me": true,
    "github_get_file_contents": true,
    "github_list_branches": true,
    "github_list_commits": true,
    "github_get_commit": true,
    "github_list_issues": true,
    "github_search_issues": true,
    "github_issue_read": true,
    "github_issue_write": true,
    "github_list_pull_requests": true,
    "github_search_pull_requests": true,
    "github_pull_request_read": true,
    "github_create_pull_request": true,
    "github_update_pull_request": true,
    "github_merge_pull_request": true,
    "github_add_issue_comment": true
  },
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "adversarial-review": {
      "model": "openai/gpt-5.6-luna",
      "description": "Do an adversarial review of the changes.",
      "prompt": "Review thes change and find problems with it. Report them. Why do you think its bad. What is bad. And maybe even a proposal for a better solution. Be very critical and adversarial.",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "read": "allow"
      },
      "tools": {
        "agentgateway_*": false,
        "github_*": false,
        "mem*": false,
        "codesearch": false,
        "codeoutline": false,
        "codeexpand": false
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "tools": {
        "agentgateway_*": false,
        "github_*": false
      }
    },
    "commit-review": {
      "model": "openai/gpt-5.6-terra",
      "description": "Review the current staged git changes. Provide feedback on code quality, style, and potential issues.",
      "prompt": "You are a senior software engineer reviewing the following git changes. Provide constructive feedback on code quality, style, and potential issues. Suggest improvements where necessary.",
      "permission": {
        "write": "ask",
        "edit": "ask"
      },
      "tools": {
        "agentgateway_*": false,
        "github_*": false,
        "mem*": false,
        "codesearch": false,
        "codeoutline": false,
        "codeexpand": false
      }
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.6-luna-flex": {
          "id": "openai/gpt-5.6-luna",
          "name": "GPT-5.6 Luna Flex",
          "options": {
            "serviceTier": "flex",
            "reasoningEffort": "low"
          }
        },
        "~deepseek/deepseek-v4-flash-latest": {
          "id": "~deepseek/deepseek-v4-flash-latest",
          "name": "DeepSeek V4 Flash (offical provider)",
          "options": {
            "provider": {
              "only": ["deepseek"]
            }
          }
        }
      }
    },
    "meta": {
      "npm": "@ai-sdk/openai",
      "name": "Meta",
      "options": {
        "baseURL": "https://api.meta.ai/v1"
      }
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "gemma4-12b": {
          "name": "Gemma 4 12B",
          "family": "gemma4",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gemma4-26b-a4b": {
          "name": "Gemma 4 26B-A4B",
          "family": "gemma4",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gemma4-e4b": {
          "name": "Gemma 4 E4B",
          "family": "gemma4",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "safety-watch": {
          "name": "Safety Watch (Qwen 3.5 4B)",
          "family": "qwen3.5",
          "attachment": false,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen35-2b": {
          "name": "Qwen 3.5 2B",
          "family": "qwen3.5",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen35-4b": {
          "name": "Qwen 3.5 4B",
          "family": "qwen3.5",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen35-4b-128": {
          "name": "Qwen 3.5 4B 128k",
          "family": "qwen3.5",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen35-9b": {
          "name": "Qwen 3.5 9B",
          "family": "qwen3.5",
          "attachment": true,
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        // Alias for the safety-watch model
        "safety-watch": {
          "name": "Qwen3.5:4B",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "low"
          }
        },
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "cerebro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebro Arbeit",
      "options": {
        "baseURL": "https://chat.cerebroai.de/api"
      },
      "models": {
        "gpt-5.2": {
          "name": "gpt-5.2",
          "limit": {
            "context": 400000,
            "output": 100000
          },
          "options": {
            "reasoningSummary": false
          },
          "reasoning": false,
          "tool_call": true
        },
        "gemini-2.5-flash": {
          "name": "gemini-2.5-flash",
          "limit": {
            "context": 400000,
            "output": 100000
          },
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "plugin": [
    "@plannotator/opencode@latest",
    // "oh-my-openagent@latest"
    [
      "/home/misti/source/safety-watch/index.ts",
      {
        "enabled": true,
        "stage1": {
          "model": "llama-cpp/safety-watch",
          "options": {
            "reasoningEffort": "low"
          }
        },
        "stage2": {
          "model": "openai/gpt-5.6-luna",
          "options": {
            "reasoningEffort": "low"
          }
        },
        "dcg": false,
        "ai-review": true,
        "approve-on-fail": true,
        "notifications": {
          "enabled": false,
          "sound": false,
          "volume": 1,
          // "sound-file": "~/sound/default.mp3",
          "on-error": {
            "enabled": true
          },
          // "on-block": {
          //   "enabled": false
          // },
          "on-ask": {
            "enabled": true,
            "sound": true
          }
          // "on-cache-miss": {
          //   "enabled": false
          // }
        }
      }
    ],
    "./plugins/openviking.mjs"
    //"/home/misti/source/opencode-telegram/src/index.ts"
  ],

  "mcp": {
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--autoConnect"
      ]
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "systemd-run",
        "--user",
        "--quiet",
        "--pipe",
        "--wait",
        "--collect",
        "--setenv=PLAYWRIGHT_MCP_EXTENSION_TOKEN",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--extension"
      ]
    },
    "livekit-docs": {
      "enabled": false,
      "type": "remote",
      "url": "https://docs.livekit.io/mcp"
    },
    "kubernetes": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest"]
    },
    "thunderbird-mail": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "--package",
        "github:TKasperczyk/thunderbird-mcp",
        "thunderbird-mcp"
      ]
    },
    "k6": {
      "type": "local",
      "enabled": false,
      "command": ["k6", "x", "mcp"]
    },
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      }
    },
    "computer-use-linux": {
      "enabled": false,
      "type": "local",
      "command": ["computer-use-linux", "mcp"]
    },
    "agentgateway": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.meisterlala.dev",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:AGENTGATEWAY_KEY}"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "playwright_browser_wait_for": "deny",
    "external_directory": {
      "*": "ask",
      "~/.config/nvim/tmp/**": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "sudo*": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
