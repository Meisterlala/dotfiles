[Unit]
Description=llama.cpp model server
Wants=network-online.target
After=network-online.target
Wants=llama-server-models.path

[Service]
Type=simple
ExecStart=/usr/bin/llama-server --models-preset %h/.config/llama-cpp/models.ini --port 11435 --metrics
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
